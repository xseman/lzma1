{
	"name": "lzma1",
	"type": "module",
	"version": "0.4.1",
	"license": "Apache-2.0",
	"author": "Filip Seman <filip.seman@pm.me>",
	"description": "A JavaScript implementation of the Lempel-Ziv-Markov (LZMA) chain compression algorithm",
	"funding": "https://github.com/sponsors/xseman",
	"homepage": "https://github.com/xseman/lzma1",
	"keywords": [
		"lzma",
		"lzma1",
		"lzma alone"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/xseman/lzma1"
	},
	"scripts": {
		"prebuild": "tsc --build --clean",
		"build": "tsc --build",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"typecheck": "tsc --noEmit",
		"bench": "cd bench && bun install && bun run bench",
		"bench:report": "cd bench && bun install && bun run report",
		"test": "bun test src/ --coverage --coverage-reporter=text --coverage-reporter=lcov --concurrent",
		"test:watch": "bun test src/ --watch --coverage --concurrent"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"@types/node": "^25.5.2",
		"dprint": "~0.54.0",
		"typescript": "^6.0.2"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"sideEffects": false,
	"types": "./lib/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./lib/index.d.ts",
			"bun": "./src/index.ts",
			"import": "./lib/index.js",
			"require": "./lib/index.js"
		}
	},
	"files": [
		"lib/**/*.js",
		"lib/**/*.d.ts",
		"!lib/**/*_test*",
		"src/**/*.ts",
		"!src/**/*_test.ts"
	]
}
